<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <report
            id="action_report_steel_quote"
            model="sale.order"
            string="Steel Quote"
            report_type="qweb-pdf"
            name="sales_custom2.report_document"
            file="sales_custom2.report_document"
            attachment_use="False"
        />

        <!-- Report Template -->
        <template id="report_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <!-- Billing & Shipping Address Table -->
                            <table class="table table-bordered" style="width:100%; margin-bottom:10px;">
                                <tr>
                                    <th style="width:50%; background-color:#f0f0f0;">Billing Address</th>
                                    <th style="width:50%; background-color:#f0f0f0;">Shipping Address</th>
                                </tr>
                                <tr>
                                    <td>
                                        <t t-if="o.partner_invoice_id">
                                            <span t-field="o.partner_invoice_id.name"/><br/>
                                            <span t-field="o.partner_invoice_id.street"/><br/>
                                            <t t-if="o.partner_invoice_id.street2">
                                                <span t-field="o.partner_invoice_id.street2"/><br/>
                                            </t>
                                            <span t-field="o.partner_invoice_id.city"/>,
                                            <span t-field="o.partner_invoice_id.state_id.name"/>
                                            <span t-field="o.partner_invoice_id.zip"/><br/>
                                            <span t-field="o.partner_invoice_id.phone"/>
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="o.partner_shipping_id">
                                            <span t-field="o.partner_shipping_id.name"/><br/>
                                            <span t-field="o.partner_shipping_id.street"/><br/>
                                            <t t-if="o.partner_shipping_id.street2">
                                                <span t-field="o.partner_shipping_id.street2"/><br/>
                                            </t>
                                            <span t-field="o.partner_shipping_id.city"/>,
                                            <span t-field="o.partner_shipping_id.state_id.name"/>
                                            <span t-field="o.partner_shipping_id.zip"/><br/>
                                            <span t-field="o.partner_shipping_id.phone"/>
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <!-- Payment Terms / shipping / Quote Date / Ship Date -->
                            <table class="table table-bordered" style="width:100%; margin-bottom:15px;">
                                <tr>
                                    <th style="background-color:#f0f0f0; text-align:center;">Payment Terms</th>
                                    <th style="background-color:#f0f0f0; text-align:center;">shipping</th>
                                    <th style="background-color:#f0f0f0; text-align:center;">Quote Date</th>
                                    <th style="background-color:#f0f0f0; text-align:center;">Ship Date</th>
                                     <th style="background-color:#f0f0f0; text-align:center;">Delivery Date</th>
                                </tr>
                                <tr>
                                    <td style="text-align:center;">
                                        <span t-field="o.payment_term_id.name"/>
                                    </td>
                                    <td style="text-align:center;">
                                        <!-- Custom field: shipping if you have it -->
                                        <span t-if="o.shipping" t-field="o.shipping"/>
                                    </td>
                                    <td style="text-align:center;">
                                        <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td style="text-align:center;">
                                        <!-- Custom field: so_ship_date if you have it -->
                                        <span t-if="o.so_ship_date" t-field="o.so_ship_date"/>
                                    </td>
                                     <td>
                                        <span t-field="o.delivery_date"/>
                                     </td>
                                </tr>
                            </table>

                            <!-- Order Lines Table -->
                            <table class="table table-bordered" style="width:100%; margin-bottom:15px;">
                                <thead>
                                    <tr style="background-color:#f0f0f0;">
        <th>Description</th>
        <th class="text-center">Qty</th>
        <th class="text-right">Unit Price</th>
        <th class="text-right">Subtotal</th>
    </tr>
</thead>

                                <tbody>
    <t t-foreach="o.order_line" t-as="line">
        <tr>
            <td>
                <span t-field="line.name"/>
            </td>

            <td class="text-center">
                <span t-field="line.product_uom_qty"/>
                <span t-field="line.product_uom.name"/>
            </td>

            <td class="text-right">
                <span t-field="line.price_unit"
                      t-options='{"widget":"monetary",
                                   "display_currency":o.currency_id}'/>
            </td>

            <td class="text-right">
                <span t-field="line.price_subtotal"
                      t-options='{"widget":"monetary",
                                   "display_currency":o.currency_id}'/>
            </td>
        </tr>
    </t>
</tbody>
                            </table>

                            <!-- Total Weight + Subtotals side by side -->
                   <!--         <div class="row">
                                <div class="col-6">
                                    <strong>Total Weight: </strong>

                                    <span t-if="o.x_total_weight" t-field="o.x_total_weight"/> lbs
                                    <t t-if="not o.x_total_weight">0.00 lbs</t>
                                </div>
                                <div class="col-6">
