                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-right">
                                                Taxes on
                                                <span t-field="o.amount_untaxed"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-right">
                                                <span t-field="o.amount_tax"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-right">Tax (if applicable):</td>
                                            <td class="text-right">$0.00</td>
                                        </tr>
                                        <tr>
                                            <td class="text-right"><strong>Total</strong></td>
                                            <td class="text-right">
                                                <span t-field="o.amount_total"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>  -->

                            <!-- Remarks Section -->
                            <div style="margin-top:20px; border:1px solid black; padding:5px;">
                                <div style="background-color:#f0f0f0; padding:5px; text-align:center;">
                                    <strong>Remarks</strong>
                                </div>
                                <div style="min-height:60px; padding:10px;">
                                    <span t-if="o.note" t-field="o.note"/>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>