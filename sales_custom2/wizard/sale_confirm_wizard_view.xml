<odoo>

    <record id="view_sale_confirm_wizard" model="ir.ui.view">
        <field name="name">sale.confirm.wizard.form</field>
        <field name="model">sale.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Quotation">

                <group>
                    <div>
                        <p>Do you want to confirm this quotation?</p>
                    </div>
                </group>

                <footer>

                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>
        </field>
    </record>

</odoo>