<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Yield Tracking Sequence -->
        <record id="seq_yield_tracking" model="ir.sequence">
            <field name="name">Yield Tracking</field>
            <field name="code">yield.tracking</field>
            <field name="prefix">YT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- COPQ Report Sequence -->
        <record id="seq_copq_report" model="ir.sequence">
            <field name="name">COPQ Report</field>
            <field name="code">copq.report</field>
            <field name="prefix">COPQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

    </data>
</odoo>
