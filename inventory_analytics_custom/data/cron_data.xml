<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Auto-recompute yield-adjusted costs on products (daily) -->
        <record id="cron_recompute_yield_cost" model="ir.cron">
            <field name="name">Yield Management: Recompute Yield-Adjusted Costs</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">
products = env['product.template'].search([('material_grade', '!=', False)])
products._compute_yield_adjusted_cost()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
