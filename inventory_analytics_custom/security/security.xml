<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module Category -->
        <record id="module_category_yield_management" model="ir.module.category">
            <field name="name">Yield Management</field>
            <field name="description">Category for Yield &amp; Scrap Loss Management</field>
            <field name="sequence">50</field>
        </record>

        <!-- User Group -->
        <record id="group_yield_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_yield_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_yield_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_yield_management"/>
            <field name="implied_ids" eval="[(4, ref('group_yield_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="yield_tracking_company_rule" model="ir.rule">
            <field name="name">Yield Tracking: Multi-Company</field>
            <field name="model_id" ref="model_yield_tracking"/>
            <field name="domain_force">[('company_id', 'in', [user.company_id.id, False])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="copq_report_company_rule" model="ir.rule">
            <field name="name">COPQ Report: Multi-Company</field>
            <field name="model_id" ref="model_copq_report"/>
            <field name="domain_force">[('company_id', 'in', [user.company_id.id, False])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="process_step_company_rule" model="ir.rule">
            <field name="name">Process Step: Multi-Company</field>
            <field name="model_id" ref="model_process_step"/>
            <field name="domain_force">[('company_id', 'in', [user.company_id.id, False])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="yield_loss_type_company_rule" model="ir.rule">
            <field name="name">Yield Loss Type: Multi-Company</field>
            <field name="model_id" ref="model_yield_loss_type"/>
            <field name="domain_force">[('company_id', 'in', [user.company_id.id, False])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
