<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Yield Tracking: Tree View -->
    <record id="view_yield_tracking_tree" model="ir.ui.view">
        <field name="name">yield.tracking.tree</field>
        <field name="model">yield.tracking</field>
        <field name="arch" type="xml">
            <tree string="Yield Tracking"
                  decoration-danger="yield_status == 'critical'"
                  decoration-warning="yield_status == 'warning'"
                  decoration-success="yield_status == 'good'">
                <field name="name"/>
                <field name="date"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="material_grade"/>
                <field name="process_step_id"/>
                <field name="input_qty"/>
                <field name="output_qty"/>
                <field name="loss_qty"/>
                <field name="actual_yield_pct" string="Yield %"/>
                <field name="theoretical_yield_pct" string="Expected %"/>
                <field name="yield_variance" string="Variance %"/>
                <field name="total_loss_cost" sum="Total Loss Cost"/>
                <field name="yield_status"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Yield Tracking: Form View -->
    <record id="view_yield_tracking_form" model="ir.ui.view">
        <field name="name">yield.tracking.form</field>
        <field name="model">yield.tracking</field>
        <field name="arch" type="xml">
            <form string="Yield Tracking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            states="draft" class="btn-primary"/>
                    <button name="action_done" string="Mark Done" type="object"
                            states="confirmed" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            states="draft,confirmed"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            states="cancelled"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_scrap_orders" type="object"
                                class="oe_stat_button" icon="fa-trash"
                                attrs="{'invisible': [('scrap_count', '=', 0)]}">
                            <field name="scrap_count" widget="statinfo" string="Scrap Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="date"/>
                            <field name="production_id"/>
                            <field name="process_step_id"/>
                            <field name="product_id"/>
                            <field name="lot_id" context="{'default_product_id': product_id,'default_company_id': company_id}"/>
                            <field name="material_grade"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Quantities &amp; Yield">
                            <field name="input_qty"/>
                            <field name="output_qty"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="loss_qty" class="text-danger"/>
                            <field name="unit_cost"/>
                            <field name="total_input_cost"/>
                            <field name="total_loss_cost" class="text-danger"/>
                        </group>
                    </group>
                    <group>
                        <group string="Yield Analysis">
                            <field name="theoretical_yield_pct" string="Theoretical Yield (%)"/>
                            <field name="actual_yield_pct" string="Actual Yield (%)"/>
                            <field name="yield_variance" string="Variance (%)"/>
                            <field name="yield_status"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Loss Breakdown" name="loss_lines">
                            <field name="loss_line_ids"
                                   attrs="{'readonly': [('state', 'in', ['done', 'cancelled'])]}">
                                <tree string="Loss Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="loss_type_id"/>
                                    <field name="loss_category" readonly="1"/>
                                    <field name="loss_qty"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="loss_pct" string="Loss %"/>
                                    <field name="unit_cost"/>
                                    <field name="loss_cost" sum="Total Loss Cost"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Yield Tracking: Search View -->
    <record id="view_yield_tracking_search" model="ir.ui.view">
        <field name="name">yield.tracking.search</field>
        <field name="model">yield.tracking</field>
        <field name="arch" type="xml">
            <search string="Yield Tracking">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="material_grade"/>
                <field name="process_step_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Critical Yield" name="critical"
                        domain="[('yield_status', '=', 'critical')]"/>
                <filter string="Warning" name="warning"
                        domain="[('yield_status', '=', 'warning')]"/>
                <filter string="Good" name="good"
                        domain="[('yield_status', '=', 'good')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Material Grade" name="group_grade"
                            context="{'group_by': 'material_grade'}"/>
                    <filter string="Process Step" name="group_step"
                            context="{'group_by': 'process_step_id'}"/>
                    <filter string="Manufacturing Order" name="group_production"
                            context="{'group_by': 'production_id'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Yield Status" name="group_yield_status"
                            context="{'group_by': 'yield_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Yield Tracking: Pivot View -->
    <record id="view_yield_tracking_pivot" model="ir.ui.view">
        <field name="name">yield.tracking.pivot</field>
        <field name="model">yield.tracking</field>
        <field name="arch" type="xml">
            <pivot string="Yield Analysis">
                <field name="process_step_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="input_qty" type="measure"/>
                <field name="output_qty" type="measure"/>
                <field name="loss_qty" type="measure"/>
                <field name="actual_yield_pct" type="measure"/>
                <field name="total_loss_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Yield Tracking: Graph View -->
    <record id="view_yield_tracking_graph" model="ir.ui.view">
        <field name="name">yield.tracking.graph</field>
        <field name="model">yield.tracking</field>
        <field name="arch" type="xml">
            <graph string="Yield Analysis" type="bar">
                <field name="process_step_id"/>
                <field name="actual_yield_pct" type="measure"/>
                <field name="total_loss_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Yield Tracking: Action -->
    <record id="action_yield_tracking" model="ir.actions.act_window">
        <field name="name">Yield Tracking</field>
        <field name="res_model">yield.tracking</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_yield_tracking_search"/>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first yield tracking entry
            </p>
            <p>
                Track material yield at each process step of manufacturing.
                Record input/output quantities, categorize losses, and
                automatically generate scrap orders.
            </p>
        </field>
    </record>

    <!-- Action: Critical Yield Issues -->
    <record id="action_yield_tracking_critical" model="ir.actions.act_window">
        <field name="name">Critical Yield Issues</field>
        <field name="res_model">yield.tracking</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('yield_status', '=', 'critical')]</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</odoo>
