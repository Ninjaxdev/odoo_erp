<odoo>
    <data>
        <record id="view_asset_data_form" model="ir.ui.view">
            <field name="name">asset.data.form.view</field>
            <field name="model">company.asset</field>
            <field name="arch" type="xml">
                <form string="Asset data form">
                    <sheet>
                        <group>
                            <group>
                                <field name="asset_code"/>
                                <field name="name"/>
                                <field name="asset_type"/>
                                <field name="custom_asset_type" attrs="{'invisible':[('asset_type','!=','other')],
                                             'required':[('asset_type','=','other')]}"/>
                                <field name="employee_id"/>
                                <field name="employee_name"/>
                                <field name="assign_date"/>
                                <field name="return_date"/>
                                <field name="status"/>
                                <field name="assigned_by"/>
                                <field name="remarks"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_asset_data_tree" model="ir.ui.view">
            <field name="name">asset.data.tree.view</field>
            <field name="model">company.asset</field>
        <field name="arch" type="xml">
            <tree string="Asset data tree"
      decoration-success="status == 'returned'"
      decoration-warning="status == 'assigned'">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="employee_id"/>
                <field name="status"/>
            </tree>
        </field>
        </record>
        <!-- Action -->
        <record id="action_asset_management" model="ir.actions.act_window">
            <field name="name">Asset Management</field>
            <field name="res_model">company.asset</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Root Menu -->
        <menuitem
            id="menu_asset_root"
            name="Asset Management"
            sequence="10"/>

        <!-- Child Menu -->
        <menuitem
            id="menu_asset_management"
            name="Assets"
            parent="menu_asset_root"
            action="action_asset_management"
            sequence="1"/>
    </data>
</odoo>