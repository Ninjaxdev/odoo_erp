<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_coupon_applied" model="mail.template">
        <field name="name">Coupon Applied - Notification</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Coupon Applied to Your Order {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background-color: #875A7B; padding: 20px; text-align: center;">
                    <h1 style="color: white; margin: 0;">Coupon Applied Successfully!</h1>
                </div>
                <div style="padding: 30px; background-color: #f9f9f9;">
                    <p>Dear <strong><t t-esc="object.partner_id.name"/></strong>,</p>
                    <p>Great news! A coupon has been successfully applied to your order.</p>

                    <div style="background: white; border: 1px solid #ddd; border-radius: 8px; padding: 20px; margin: 20px 0;">
                        <h3 style="color: #875A7B; margin-top: 0;">Order Details</h3>
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="padding: 8px 0; color: #666;">Order Number:</td>
                                <td style="padding: 8px 0; font-weight: bold;">
                                    <t t-esc="object.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 0; color: #666;">Coupon Code:</td>
                                <td style="padding: 8px 0; font-weight: bold; color: #875A7B;">
                                    <t t-esc="object.coupon_id.code"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 0; color: #666;">Order Total:</td>
                                <td style="padding: 8px 0;">
                                    <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr style="background-color: #e8f5e9;">
                                <td style="padding: 8px; color: #2e7d32; font-weight: bold;">
                                    You Saved:
                                </td>
                                <td style="padding: 8px; color: #2e7d32; font-weight: bold; font-size: 18px;">
                                    <t t-esc="object.coupon_discount_amount"/>
                                    <t t-esc="object.currency_id.symbol"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 0; color: #666;">Amount After Discount:</td>
                                <td style="padding: 8px 0; font-weight: bold; font-size: 16px;">
                                    <t t-esc="object.amount_after_discount"/>
                                    <t t-esc="object.currency_id.symbol"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <p style="color: #666;">
                        Thank you for shopping with us! Your coupon discount has been applied
                        and will be reflected in your final invoice.
                    </p>

                    <p style="color: #666;">
                        If you have any questions, please don't hesitate to contact us.
                    </p>

                    <p>Best regards,<br/>
                        <strong><t t-esc="object.company_id.name"/></strong>
                    </p>
                </div>
                <div style="background-color: #875A7B; padding: 15px; text-align: center;">
                    <p style="color: white; margin: 0; font-size: 12px;">
                        Powered by EOXS Smart Discount System
                    </p>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
