<odoo>
    <data>

        <!-- 🔹 Single Clean Form Inheritance -->
        <record id="sale_order_form_inherit_custom" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- ✅ Add state in status bar -->
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="statusbar_visible">
                        draft,sent,approval_waiting,sale
                    </attribute>
                </xpath>

                <!-- ✅ Approve button in HEADER -->
                <xpath expr="//header" position="inside">
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('state', '!=', 'approval_waiting'), ('is_approved', '=', True)]}"/>
                </xpath>

                <!-- ✅ Fields below customer -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <group>
                        <field name="custom_note"/>
                        <field name="is_approved" readonly="1"/>
                    </group>
                </xpath>

                <!-- this for onchange density -->
                <xpath expr="//field[@name='order_line']/tree" position="inside">
                    <field name="density_per_unit"/>
                    <field name="total_density" readonly="1"/>
                </xpath>

            </field>
        </record>

        <!-- 🔹 Tree View -->
        <record id="sale_order_tree_inherit_custom" model="ir.ui.view">
            <field name="name">sale.order.tree.inherit.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//tree" position="inside">
                   <field name="custom_field"/>
                   <field name="mark_important"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>